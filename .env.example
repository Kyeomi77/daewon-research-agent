# ===== 공통 =====
CONTACT_EMAIL=research-it@example.co.kr        # NCBI/기타 API에 전달되는 담당자 메일(필수 권장)
LOG_LEVEL=INFO
AUDIT_LOG_QUERIES=true                          # 외부로 나간 질의어를 감사 로그(Cloud Logging)에 기록
MAX_QUERY_CHARS=500                             # 외부 API로 보낼 질의 최대 길이
# 외부 질의 차단 정규식(구분자 ';;'). 사내 개발코드·미공개 후보물질 코드 형식을 반드시 넣으세요.
# 예) 'DW-\d{3,}' 형식의 사내 코드를 막는 경우:
BLOCK_PATTERNS=\bDW[-_ ]?\d{3,}\b;;\bDWP\d{3,}\b

# ===== MCP#1 논문·특허 =====
NCBI_API_KEY=                                   # https://account.ncbi.nlm.nih.gov/ 에서 발급 (없어도 동작, 속도 제한 3 req/s)
KIPRIS_ACCESS_KEY=                              # KIPRIS Plus (https://plus.kipris.or.kr) 발급 accessKey
KIPRIS_BASE_URL=http://plus.kipris.or.kr/openapi/rest/patUtiModInfoSearchSevice
BQ_PROJECT=                                     # BigQuery 쿼리 비용이 청구될 프로젝트 ID
BQ_MAX_BYTES_BILLED=300000000000                # 쿼리 1회 최대 스캔 바이트(기본 300GB)

# ===== MCP#2 물성·활성 =====
# (API 키 불필요: PubChem / ChEMBL / DailyMed)

# ===== MCP#3 허가·법령·IIG =====
DATA_GO_KR_KEY=                                 # 공공데이터포털 '일반 인증키(Decoding)'
MFDS_PERMIT_URL=http://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService06/getDrugPrdtPrmsnInq06
LAW_OC=                                         # 국가법령정보 Open API 신청 시 등록한 OC(이메일 ID)
IIG_BACKEND=bigquery                            # bigquery | datastore  (4장 비교표 참고)
IIG_TABLE=my-project.research_ref.fda_iig       # [bigquery] scripts/load_csv_to_bq.py 로 적재한 테이블
IIG_DS_PROJECT=                                 # [datastore] 데이터 스토어가 있는 프로젝트 ID
IIG_DS_LOCATION=global                          # [datastore] global | us | eu
IIG_DATASTORE_ID=                               # [datastore] 데이터 스토어 ID (콘솔 > 데이터 스토어 목록)
IIG_DS_MAX_SCAN=500                             # [datastore] 검색 결과를 최대 몇 건까지 훑을지
# IIG 컬럼명(적재 후 실제 이름 확인해서 맞추세요)
IIG_FIELD_INGREDIENT=ingredient_name
IIG_FIELD_ROUTE=route
IIG_FIELD_FORM=dosage_form
